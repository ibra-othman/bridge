# Copy to .env and load it with your process manager, or export the variables before `npm start`.
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://your-site.example
ALLOWED_ORIGIN=https://your-site.example
TRUST_PROXY=1
ADMIN_EMAIL=you@example.com
SMTP_URL=smtp://user:password@smtp.example.com:587
MAIL_FROM="BRIDGE <no-reply@your-site.example>"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
YOUTUBE_API_KEY=
REMINDER_HOUR=18
